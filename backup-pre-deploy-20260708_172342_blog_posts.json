[
    {
        "id": "52d6de29-c18f-4fa0-b559-e208ab72af5a",
        "tenant_id": "00000000-0000-0000-0000-000000000001",
        "title": "\u039f\u03bc\u03b9\u03bb\u03af\u03b1: \u0397 \u0391\u03c5\u03c4\u03bf\u03b3\u03bd\u03c9\u03c3\u03af\u03b1 \u03c9\u03c2 \u039c\u03bf\u03bd\u03bf\u03c0\u03ac\u03c4\u03b9 \u0396\u03c9\u03ae\u03c2",
        "slug": "omilia-autognosia-kolokotronis-2026",
        "excerpt": "\u039c\u03b9\u03b1 \u03b2\u03b9\u03c9\u03bc\u03b1\u03c4\u03b9\u03ba\u03ae \u03bf\u03bc\u03b9\u03bb\u03af\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b1\u03c5\u03c4\u03bf\u03b3\u03bd\u03c9\u03c3\u03af\u03b1, \u03c4\u03b9\u03c2 21+1 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03b5\u03c5\u03c4\u03c5\u03c7\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03c3\u03c9\u03c0\u03b9\u03ba\u03ae \u03b5\u03be\u03ad\u03bb\u03b9\u03be\u03b7, \u03b1\u03c0\u03cc \u03c4\u03bf\u03bd \u03c8\u03c5\u03c7\u03bf\u03bb\u03cc\u03b3\u03bf \u039d\u03b9\u03ba\u03cc\u03bb\u03b1 \u039a\u03bf\u03bb\u03bf\u03ba\u03bf\u03c4\u03c1\u03ce\u03bd\u03b7.",
        "content": {
            "type": "doc",
            "content": [
                {
                    "type": "paragraph",
                    "content": [
                        {
                            "text": "\u039c\u03b9\u03b1 \u03c5\u03c0\u03ad\u03c1\u03bf\u03c7\u03b7 \u03b2\u03c1\u03b1\u03b4\u03b9\u03ac \u03b3\u03b5\u03bc\u03ac\u03c4\u03b7 \u03c3\u03c5\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7, \u03bc\u03bf\u03af\u03c1\u03b1\u03c3\u03bc\u03b1 \u03ba\u03b1\u03b9 \u03b2\u03b1\u03b8\u03b9\u03ad\u03c2 \u03c3\u03ba\u03ad\u03c8\u03b5\u03b9\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03bf \u03bc\u03bf\u03bd\u03bf\u03c0\u03ac\u03c4\u03b9 \u03c4\u03b7\u03c2 \u03b1\u03c5\u03c4\u03bf\u03b3\u03bd\u03c9\u03c3\u03af\u03b1\u03c2. \u039f\u03b9 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2 \u03b5\u03af\u03c7\u03b1\u03bd \u03c4\u03b7\u03bd \u03b5\u03c5\u03ba\u03b1\u03b9\u03c1\u03af\u03b1 \u03bd\u03b1 \u03b3\u03bd\u03c9\u03c1\u03af\u03c3\u03bf\u03c5\u03bd \u03c4\u03b9\u03c2 21+1 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2 \u03c4\u03b7\u03c2 \u03b5\u03c5\u03c4\u03c5\u03c7\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03b2\u03b9\u03ce\u03c3\u03bf\u03c5\u03bd \u03bc\u03b9\u03b1 \u03c0\u03c1\u03ce\u03c4\u03b7 \u03b3\u03b5\u03cd\u03c3\u03b7 \u03b1\u03c0\u03cc \u03c4\u03b7 \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b1 \u03b5\u03c3\u03c4\u03af\u03b1\u03c3\u03b7\u03c2 \u03c3\u03c4\u03bf \u03c0\u03b1\u03c1\u03cc\u03bd.",
                            "type": "text"
                        }
                    ]
                },
                {
                    "type": "heading",
                    "attrs": {
                        "level": 2
                    },
                    "content": [
                        {
                            "text": "\u03a4\u03b9 \u03c3\u03c5\u03b6\u03b7\u03c4\u03ae\u03c3\u03b1\u03bc\u03b5",
                            "type": "text"
                        }
                    ]
                },
                {
                    "type": "paragraph",
                    "content": [
                        {
                            "text": "\u0397 \u03b5\u03ba\u03b4\u03ae\u03bb\u03c9\u03c3\u03b7 \u03be\u03b5\u03ba\u03af\u03bd\u03b7\u03c3\u03b5 \u03bc\u03b5 \u03bc\u03b9\u03b1 \u03b5\u03b9\u03c3\u03b1\u03b3\u03c9\u03b3\u03ae \u03c3\u03c4\u03b7\u03bd \u03ad\u03bd\u03bd\u03bf\u03b9\u03b1 \u03c4\u03b7\u03c2 \u03b1\u03c5\u03c4\u03bf\u03b3\u03bd\u03c9\u03c3\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7 \u03c3\u03b7\u03bc\u03b1\u03c3\u03af\u03b1 \u03c4\u03b7\u03c2 \u03c3\u03c4\u03b7\u03bd \u03ba\u03b1\u03b8\u03b7\u03bc\u03b5\u03c1\u03b9\u03bd\u03ae \u03b6\u03c9\u03ae. \u039c\u03ad\u03c3\u03b1 \u03b1\u03c0\u03cc \u03b4\u03b9\u03b1\u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b1\u03c3\u03ba\u03ae\u03c3\u03b5\u03b9\u03c2, \u03bf\u03b9 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2 \u03ae\u03c1\u03b8\u03b1\u03bd \u03c3\u03b5 \u03b5\u03c0\u03b1\u03c6\u03ae \u03bc\u03b5 \u03c4\u03b1 \u03c3\u03c5\u03bd\u03b1\u03b9\u03c3\u03b8\u03ae\u03bc\u03b1\u03c4\u03ac \u03c4\u03bf\u03c5\u03c2 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03ba\u03ac\u03bb\u03c5\u03c8\u03b1\u03bd \u03bd\u03ad\u03bf\u03c5\u03c2 \u03c4\u03c1\u03cc\u03c0\u03bf\u03c5\u03c2 \u03bd\u03b1 \u03b4\u03b9\u03b1\u03c7\u03b5\u03b9\u03c1\u03af\u03b6\u03bf\u03bd\u03c4\u03b1\u03b9 \u03c4\u03bf \u03ac\u03b3\u03c7\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03c0\u03af\u03b5\u03c3\u03b7.",
                            "type": "text"
                        }
                    ]
                },
                {
                    "type": "heading",
                    "attrs": {
                        "level": 3
                    },
                    "content": [
                        {
                            "text": "\u039f\u03b9 21+1 \u03a0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2 \u03c4\u03b7\u03c2 \u0395\u03c5\u03c4\u03c5\u03c7\u03af\u03b1\u03c2",
                            "type": "text"
                        }
                    ]
                },
                {
                    "type": "paragraph",
                    "content": [
                        {
                            "text": "\u03a0\u03b1\u03c1\u03bf\u03c5\u03c3\u03b9\u03ac\u03c3\u03c4\u03b7\u03ba\u03b1\u03bd \u03bf\u03b9 \u03b2\u03b1\u03c3\u03b9\u03ba\u03ad\u03c2 \u03c0\u03bf\u03b9\u03cc\u03c4\u03b7\u03c4\u03b5\u03c2 \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b8\u03ad\u03c4\u03bf\u03c5\u03bd \u03c4\u03bf \u03bc\u03bf\u03bd\u03bf\u03c0\u03ac\u03c4\u03b9 \u03c4\u03b7\u03c2 \u03b5\u03c5\u03c4\u03c5\u03c7\u03af\u03b1\u03c2: \u03b8\u03b5\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1, \u03c3\u03c5\u03bc\u03c0\u03cc\u03bd\u03b9\u03b1, \u03b5\u03c5\u03b3\u03bd\u03c9\u03bc\u03bf\u03c3\u03cd\u03bd\u03b7, \u03b1\u03c0\u03bb\u03cc\u03c4\u03b7\u03c4\u03b1, \u03b4\u03ad\u03bf\u03c2, \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03c3\u03bc\u03cc\u03c2, \u03c8\u03c5\u03c7\u03b9\u03ba\u03ae \u03b1\u03bd\u03b8\u03b5\u03ba\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1, \u03b5\u03c0\u03af\u03b3\u03bd\u03c9\u03c3\u03b7, \u03b1\u03c0\u03bf\u03b4\u03bf\u03c7\u03ae, \u03b5\u03bd\u03c3\u03c5\u03bd\u03b1\u03af\u03c3\u03b8\u03b7\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c3\u03ba\u03bf\u03c0\u03cc\u03c2 \u03b6\u03c9\u03ae\u03c2.",
                            "type": "text"
                        }
                    ]
                },
                {
                    "type": "bulletList",
                    "content": [
                        {
                            "type": "listItem",
                            "content": [
                                {
                                    "type": "paragraph",
                                    "content": [
                                        {
                                            "text": "\u0398\u03b5\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 & \u0391\u03b9\u03c3\u03b9\u03bf\u03b4\u03bf\u03be\u03af\u03b1",
                                            "type": "text"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "listItem",
                            "content": [
                                {
                                    "type": "paragraph",
                                    "content": [
                                        {
                                            "text": "\u0395\u03bd\u03c3\u03c5\u03bd\u03b1\u03af\u03c3\u03b8\u03b7\u03c3\u03b7 & \u03a3\u03cd\u03bd\u03b4\u03b5\u03c3\u03b7",
                                            "type": "text"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "listItem",
                            "content": [
                                {
                                    "type": "paragraph",
                                    "content": [
                                        {
                                            "text": "\u0394\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03c3\u03bc\u03cc\u03c2 & \u0395\u03c0\u03af\u03b3\u03bd\u03c9\u03c3\u03b7",
                                            "type": "text"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "listItem",
                            "content": [
                                {
                                    "type": "paragraph",
                                    "content": [
                                        {
                                            "text": "\u03a8\u03c5\u03c7\u03b9\u03ba\u03ae \u0391\u03bd\u03b8\u03b5\u03ba\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1",
                                            "type": "text"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "paragraph",
                    "content": [
                        {
                            "text": "\u0397 \u03bf\u03bc\u03b9\u03bb\u03af\u03b1 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03b8\u03b7\u03ba\u03b5 \u03bc\u03b5 \u03ad\u03bd\u03b1\u03bd \u03c3\u03cd\u03bd\u03c4\u03bf\u03bc\u03bf \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03c3\u03bc\u03cc \u03ba\u03b1\u03b9 \u03c3\u03c5\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7 \u03b3\u03cd\u03c1\u03c9 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03c8\u03c5\u03c7\u03b9\u03ba\u03ae \u03b1\u03bd\u03b8\u03b5\u03ba\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03ba\u03b1\u03b8\u03b7\u03bc\u03b5\u03c1\u03b9\u03bd\u03ae \u03c0\u03c1\u03b1\u03ba\u03c4\u03b9\u03ba\u03ae \u03c4\u03b7\u03c2 \u03b5\u03bd\u03c3\u03c5\u03bd\u03b5\u03b9\u03b4\u03b7\u03c4\u03cc\u03c4\u03b7\u03c4\u03b1\u03c2. \u039f\u03b9 \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03ad\u03c7\u03bf\u03bd\u03c4\u03b5\u03c2 \u03ad\u03c6\u03c5\u03b3\u03b1\u03bd \u03bc\u03b5 \u03c0\u03c1\u03b1\u03ba\u03c4\u03b9\u03ba\u03ac \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03b1 \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03b5\u03bd\u03c4\u03ac\u03be\u03bf\u03c5\u03bd \u03c3\u03c4\u03b7 \u03b6\u03c9\u03ae \u03c4\u03bf\u03c5\u03c2.",
                            "type": "text"
                        }
                    ]
                }
            ]
        },
        "category": "\u039f\u039c\u0399\u039b\u0399\u0395\u03a3 \u03a3\u0395\u039c\u0399\u039d\u0391\u03a1\u0399\u0391",

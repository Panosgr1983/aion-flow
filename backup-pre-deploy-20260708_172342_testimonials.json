    {
        "id": "fc2fca5a-0dd1-4232-9ae1-6574c212bed9",
        "tenant_id": "00000000-0000-0000-0000-000000000001",
        "name": "\u039a\u03c9\u03bd\u03c3\u03c4\u03b1\u03bd\u03c4\u03af\u03bd\u03bf\u03c2 \u03a0.",
        "title": "\u0399\u03b4\u03b9\u03c9\u03c4\u03b9\u03ba\u03cc\u03c2 \u03c5\u03c0\u03ac\u03bb\u03bb\u03b7\u03bb\u03bf\u03c2",
        "content": "\u03a4\u03b9 \u03bd\u03b1 \u03c0\u03c1\u03c9\u03c4\u03bf\u03c0\u03b5\u03af \u03ba\u03ac\u03c0\u03bf\u03b9\u03bf\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03bf\u03bd \u039d\u03b9\u03ba\u03cc\u03bb\u03b1. \u0395\u03be\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03cc\u03c2 \u03ac\u03bd\u03b8\u03c1\u03c9\u03c0\u03bf\u03c2 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03b8\u03bf\u03b4\u03b7\u03b3\u03b7\u03c4\u03ae\u03c2 \u03c3\u03c4\u03b7 \u03b6\u03c9\u03ae \u03bc\u03bf\u03c5. \u0395\u03b4\u03ce \u03ba\u03b1\u03b9 \u03ba\u03ac\u03c0\u03bf\u03b9\u03b1 \u03c7\u03c1\u03cc\u03bd\u03b9\u03b1, \u03b6\u03c9 \u03bc\u03b5 \u03b1\u03b3\u03c7\u03ce\u03b4\u03b5\u03b9\u03c2 \u03b4\u03b9\u03b1\u03c4\u03b1\u03c1\u03b1\u03c7\u03ad\u03c2. \u0395\u03af\u03c7\u03b1 \u03c6\u03c4\u03ac\u03c3\u03b5\u03b9 \u03c3\u03b5 \u03c3\u03b7\u03bc\u03b5\u03af\u03bf \u03bd\u03b1 \u03ad\u03c7\u03c9 \u03c7\u03ac\u03c3\u03b5\u03b9 \u03c4\u03bf\u03bd \u03b5\u03b1\u03c5\u03c4\u03cc \u03bc\u03bf\u03c5. \u03a4\u03af\u03c0\u03bf\u03c4\u03b1 \u03b4\u03b5\u03bd \u03bc\u03b5 \u03b5\u03c5\u03c7\u03b1\u03c1\u03b9\u03c3\u03c4\u03bf\u03cd\u03c3\u03b5, \u03ad\u03c3\u03c4\u03c9 \u03ba\u03b1\u03b9 \u03c4\u03b1 \u03b1\u03c0\u03bb\u03ac \u03ba\u03b1\u03b8\u03b7\u03bc\u03b5\u03c1\u03b9\u03bd\u03ac \u03c0\u03c1\u03ac\u03b3\u03bc\u03b1\u03c4\u03b1. \u0391\u03c0\u03cc \u03c4\u03b7\u03bd \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c3\u03c4\u03b9\u03b3\u03bc\u03ae \u03c0\u03bf\u03c5 \u03c3\u03c5\u03bd\u03b1\u03bd\u03c4\u03ae\u03b8\u03b7\u03ba\u03b1 \u03bc\u03b5 \u03c4\u03bf\u03bd \u039d\u03b9\u03ba\u03cc\u03bb\u03b1, \u03bc\u03cc\u03bd\u03bf \u03b7 \u03b8\u03b5\u03c4\u03b9\u03ba\u03ae \u03c4\u03bf\u03c5 \u03b1\u03cd\u03c1\u03b1, \u03bc\u03bf\u03c5 \u03ad\u03b4\u03c9\u03c3\u03b5 \u03b4\u03cd\u03bd\u03b1\u03bc\u03b7. \u039c\u03b5 \u03c4\u03b9\u03c2 \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03af\u03b5\u03c2 \u03bc\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b9\u03c2 \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ad\u03c2 \u03ba\u03b1\u03b8\u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b7\u03c2 \u03ac\u03c1\u03c7\u03b9\u03c3\u03b5 \u03b7 \u03c8\u03c5\u03c7\u03ae \u03bc\u03bf\u03c5 \u03bd\u03b1 \u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c6\u03c9\u03c2. \u0398\u03ad\u03bb\u03b5\u03b9 \u03c0\u03bf\u03bb\u03cd \u03b4\u03bf\u03c5\u03bb\u03b5\u03b9\u03ac \u03ba\u03b1\u03b9 \u03c5\u03c0\u03bf\u03bc\u03bf\u03bd\u03ae \u03bd\u03b1 \u03bd\u03b9\u03ba\u03ae\u03c3\u03b5\u03b9\u03c2 \u03c4\u03bf \u03c4\u03ad\u03c1\u03b1\u03c2 \u03bc\u03ad\u03c3\u03b1 \u03c3\u03bf\u03c5. \u0391\u03c5\u03c4\u03cc \u03c0\u03bf\u03c5 \u03bc\u03bf\u03c5 \u03ad\u03bc\u03b1\u03b8\u03b5 \u03bf \u039d\u03b9\u03ba\u03cc\u03bb\u03b1\u03c2, \u03b5\u03af\u03bd\u03b1\u03b9 \u03cc\u03c4\u03b9 \u03cc\u03bb\u03b1 \u03b8\u03ad\u03bb\u03bf\u03c5\u03bd \u03b1\u03b3\u03ac\u03c0\u03b7 \u03ba\u03b1\u03b9 \u03c3\u03b5\u03b2\u03b1\u03c3\u03bc\u03cc, \u03c0\u03c1\u03ce\u03c4\u03b1 \u03b1\u03c0' \u03cc\u03bb\u03b1 \u03c3\u03c4\u03bf\u03bd \u03b5\u03b1\u03c5\u03c4\u03cc \u03bc\u03b1\u03c2! \u039d\u03b9\u03ba\u03cc\u03bb\u03b1 \u03c3\u03b5 \u03b5\u03c5\u03c7\u03b1\u03c1\u03b9\u03c3\u03c4\u03ce \u03c0\u03bf\u03bb\u03cd! \u03a4\u03bf \u03be\u03ad\u03c1\u03c9 \u03cc\u03c4\u03b9 \u03cc\u03c0\u03bf\u03c4\u03b5 \u03c3\u03b5 \u03c7\u03c1\u03b5\u03b9\u03b1\u03c3\u03c4\u03ce, \u03b8\u03b1 \u03bc\u03b5 \u03c3\u03c5\u03bc\u03b2\u03bf\u03c5\u03bb\u03b5\u03cd\u03b5\u03b9\u03c2 \u03c0\u03ac\u03bd\u03c4\u03b1",

    {
        "id": "91c798fc-070a-4fb7-b29f-09b8bfc6c337",
        "tenant_id": "00000000-0000-0000-0000-000000000001",
        "name": "\u0395\u03cd\u03b7 \u03a1. ",
        "title": "\u0399\u03b4\u03b9\u03c9\u03c4\u03b9\u03ba\u03ae \u03c5\u03c0\u03ac\u03bb\u03bb\u03b7\u03bb\u03bf\u03c2",
        "content": "\u039f \u039d\u03b9\u03ba\u03cc\u03bb\u03b1\u03c2 \u03bc\u03b5 \u03b2\u03bf\u03ae\u03b8\u03b7\u03c3\u03b5 \u03c0\u03bf\u03bb\u03cd \u03bd\u03b1 \u03bf\u03c1\u03b3\u03b1\u03bd\u03ce\u03c3\u03c9 \u03c4\u03b9\u03c2 \u03c3\u03ba\u03ad\u03c8\u03b5\u03b9\u03c2 \u03bc\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03b4\u03c9 \u03ba\u03ac\u03c0\u03bf\u03b9\u03b1 \u03c0\u03c1\u03ac\u03b3\u03bc\u03b1\u03c4\u03b1 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03b5\u03c4\u03b9\u03ba\u03ac. \u0388\u03bd\u03b9\u03c9\u03c3\u03b1 \u03ac\u03bd\u03b5\u03c4\u03b1 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03b1\u03c1\u03c7\u03ae, \u03c7\u03c9\u03c1\u03af\u03c2 \u03c0\u03af\u03b5\u03c3\u03b7. \u0395\u03ba\u03c4\u03af\u03bc\u03b7\u03c3\u03b1 \u03c0\u03bf\u03bb\u03cd \u03c4\u03bf\u03bd \u03c4\u03c1\u03cc\u03c0\u03bf \u03c0\u03bf\u03c5 \u03b1\u03ba\u03bf\u03cd\u03b5\u03b9, \u03c0\u03bf\u03bb\u03cd \u03ba\u03b1\u03bb\u03cc\u03c2 \u03c3\u03c4\u03b7 \u03b4\u03bf\u03c5\u03bb\u03b5\u03b9\u03ac \u03c4\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03c0\u03ac\u03bd\u03c9 \u03b1\u03c0\u2019 \u03cc\u03bb\u03b1 \u03b1\u03bd\u03b8\u03c1\u03ce\u03c0\u03b9\u03bd\u03bf\u03c2. \u0397 \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c3\u03af\u03b1 \u03bc\u03b1\u03c2 \u03ae\u03c4\u03b1\u03bd \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03b2\u03bf\u03b7\u03b8\u03b7\u03c4\u03b9\u03ba\u03ae. \u03a0\u03bf\u03bb\u03cd \u03b8\u03b5\u03c4\u03b9\u03ba\u03ae \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u039e\u03b5\u03c7\u03c9\u03c1\u03af\u03b6\u03b5\u03b9 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b5\u03bd\u03c3\u03c5\u03bd\u03b1\u03af\u03c3\u03b8\u03b7\u03c3\u03b7, \u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03c3\u03bf\u03c7\u03ae \u03ba\u03b1\u03b9 \u03c4\u03bf\u03bd \u03b5\u03c0\u03b1\u03b3\u03b3\u03b5\u03bb\u03bc\u03b1\u03c4\u03b9\u03c3\u03bc\u03cc \u03c4\u03bf\u03c5",

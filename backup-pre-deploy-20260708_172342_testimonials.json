        "tenant_id": "00000000-0000-0000-0000-000000000001",
        "name": "\u0395\u03cd\u03b1 \u03a3.",
        "title": "\u03a3\u03c5\u03bd\u03c4\u03b1\u03be\u03b9\u03bf\u03cd\u03c7\u03bf\u03c2",
        "content": "\u03a4\u03bf \u03b4\u03b9\u03ba\u03cc \u03bc\u03bf\u03c5 \u03c4\u03b1\u03be\u03af\u03b4\u03b9 \u03b1\u03c5\u03c4\u03bf\u03b3\u03bd\u03c9\u03c3\u03af\u03b1\u03c2 \u03be\u03b5\u03ba\u03af\u03bd\u03b7\u03c3\u03b5 \u03c0\u03c1\u03b9\u03bd \u03c0\u03bf\u03bb\u03bb\u03ac \u03c7\u03c1\u03cc\u03bd\u03b9\u03b1 \u03bc\u03b5 \u03b4\u03b9\u03b1\u03c6\u03bf\u03c1\u03b5\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03c8\u03c5\u03c7\u03bf\u03bb\u03cc\u03b3\u03bf\u03c5\u03c2. \u0386\u03bb\u03bb\u03bf\u03c4\u03b5 \u03b5\u03c0\u03b9\u03ba\u03c1\u03b9\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2, \u03ac\u03bb\u03bb\u03bf\u03c4\u03b5 \u03b2\u03bf\u03b7\u03b8\u03b7\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2 \u03ba\u03b1\u03b9 \u03ac\u03bb\u03bb\u03bf\u03c4\u03b5 \u03ad\u03c9\u03c2 \u03ba\u03b1\u03b9 \u03ba\u03b1\u03ba\u03bf\u03c0\u03bf\u03b9\u03b7\u03c4\u03b9\u03ba\u03bf\u03cd\u03c2. \u0388\u03c6\u03b5\u03c5\u03b3\u03b1 \u03c7\u03c9\u03c1\u03af\u03c2 \u03bd\u03b1 \u03c0\u03ac\u03c1\u03c9 \u03c4\u03b7\u03bd \u03b2\u03bf\u03ae\u03b8\u03b5\u03b9\u03b1 \u03c0\u03bf\u03c5 \u03c7\u03c1\u03b5\u03b9\u03b1\u03b6\u03cc\u03bc\u03bf\u03c5\u03bd. \n\u0391\u03c5\u03c4\u03cc \u03bc\u03b5 \u03ad\u03ba\u03b1\u03bd\u03b5 \u03cc\u03bc\u03c9\u03c2 \u03bd\u03b1 \u03b1\u03c0\u03bf\u03ba\u03c4\u03ae\u03c3\u03c9 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1 \u03c3\u03c4\u03bf\u03bd \u03c0\u03bf\u03b9\u03bf\u03bd \u03b8\u03b1 \u03b5\u03bc\u03c0\u03b9\u03c3\u03c4\u03b5\u03c5\u03b8\u03ce \u03bd\u03b1 \u03b1\u03bd\u03bf\u03af\u03be\u03c9 \u03c4\u03b7\u03bd \u03c8\u03c5\u03c7\u03ae \u03bc\u03bf\u03c5.\n\u039c\u03b9\u03b1 \u03c0\u03c1\u03ce\u03c4\u03b7 \u03c3\u03c5\u03bd\u03ac\u03bd\u03c4\u03b7\u03c3\u03b7 \u03bc\u03b5 \u03c4\u03bf\u03bd \u039d\u03b9\u03ba\u03cc\u03bb\u03b1 \u039a\u03bf\u03bb\u03bf\u03ba\u03bf\u03c4\u03c1\u03ce\u03bd\u03b7 \u03bc\u03b5 \u03bf\u03b4\u03ae\u03b3\u03b7\u03c3\u03b5 \u03c3\u03b5 \u03bc\u03b9\u03b1 \u03bf\u03c5\u03c3\u03b9\u03b1\u03c3\u03c4\u03b9\u03ba\u03ae \u03ba\u03b1\u03b9 \u03c5\u03c0\u03ad\u03c1\u03bf\u03c7\u03b7 \u03c3\u03b5\u03b9\u03c1\u03ac \u03c3\u03c5\u03bd\u03b5\u03b4\u03c1\u03b9\u03ce\u03bd, \u03c0\u03bf\u03c5 \u03bc\u03b5 \u03ad\u03ba\u03b1\u03bd\u03b5 \u03c3\u03b9\u03b3\u03ac \u03c3\u03b9\u03b3\u03ac \u03bd\u03b1 \u03b1\u03c0\u03bf\u03c3\u03c5\u03bc\u03c0\u03b9\u03b5\u03c3\u03c4\u03ce \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03bc\u03b5 \u03bf\u03b4\u03b7\u03b3\u03ae\u03c3\u03b5\u03b9 \u03bd\u03b1  \u03b4\u03bf\u03c5\u03bb\u03ad\u03c8\u03bf\u03c5\u03bc\u03b5 \u03c4\u03bf\u03bd \u03b5\u03c3\u03c9\u03c4\u03b5\u03c1\u03b9\u03ba\u03cc \u03b4\u03c1\u03cc\u03bc\u03bf \u03c4\u03b7\u03c2 \u03b3\u03b1\u03bb\u03ae\u03bd\u03b7\u03c2 \u03c0\u03bf\u03c5 \u03c4\u03cc\u03c3\u03bf \u03c7\u03c1\u03b5\u03b9\u03b1\u03b6\u03cc\u03bc\u03bf\u03c5\u03bd, \u03c0\u03c1\u03bf\u03c3\u03c4\u03b1\u03c4\u03b5\u03c5\u03bc\u03ad\u03bd\u03b7 \u03ba\u03b1\u03b9 \u03b1\u03bd\u03b1\u03ba\u03bf\u03c5\u03c6\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7.\n\u0395\u03af\u03bd\u03b1\u03b9 \u03b5\u03be\u03b1\u03b9\u03c1\u03b5\u03c4\u03b9\u03ba\u03cc\u03c2 \u03b5\u03c0\u03b9\u03c3\u03c4\u03ae\u03bc\u03bf\u03bd\u03b1\u03c2, \u03ba\u03bf\u03bd\u03c4\u03ac \u03c3\u03c4\u03bf\u03bd \u03ac\u03bd\u03b8\u03c1\u03c9\u03c0\u03bf, \u03bc\u03b5 \u03b3\u03bd\u03ce\u03c3\u03b5\u03b9\u03c2, \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03af\u03b1, \u03bc\u03b5\u03c4\u03b1\u03b4\u03bf\u03c4\u03b9\u03ba\u03cc\u03c4\u03b7\u03c4\u03b1. \u0398\u03b1 \u03c4\u03bf\u03bd \u03c3\u03cd\u03c3\u03c4\u03b7\u03bd\u03b1 \u03b1\u03bd\u03b5\u03c0\u03b9\u03c6\u03cd\u03bb\u03b1\u03ba\u03c4\u03b1 \u03c3\u03b5 \u03cc\u03c0\u03bf\u03b9\u03bf\u03bd \u03b6\u03b7\u03c4\u03bf\u03cd\u03c3\u03b5 \u03c4\u03b7 \u03b3\u03bd\u03ce\u03bc\u03b7 \u03bc\u03bf\u03c5!",

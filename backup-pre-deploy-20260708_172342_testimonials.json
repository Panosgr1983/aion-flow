[
    {
        "id": "73798caf-8e32-4608-ac4b-9f6555466a13",
        "tenant_id": "00000000-0000-0000-0000-000000000001",
        "name": "\u0391\u03b3\u03b3\u03b5\u03bb\u03b9\u03ba\u03ae \u039c.",
        "title": "\u039a\u03b1\u03b8\u03b7\u03b3\u03ae\u03c4\u03c1\u03b9\u03b1",
        "content": "\u0397 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03c5\u03c4\u03b9\u03ba\u03ae \u03c0\u03bf\u03c1\u03b5\u03af\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03bc\u03b9\u03b1 \u03b2\u03b1\u03b8\u03b9\u03ac \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b1 \u03ad\u03bd\u03c4\u03bf\u03bd\u03b7\u03c2 \u03b1\u03bd\u03b1\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7\u03c2 \u03ba\u03b1\u03b9 \u03b7 \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03af\u03b1 \u03c4\u03bf\u03c5 \u03ba\u03b1\u03c4\u03ac\u03bb\u03bb\u03b7\u03bb\u03bf\u03c5 \u03b5\u03b9\u03b4\u03b9\u03ba\u03bf\u03cd \u03b3\u03b9\u03b1 \u03bd\u03b1 \u03c3\u03b5 \u03ba\u03b1\u03b8\u03bf\u03b4\u03b7\u03b3\u03ae\u03c3\u03b5\u03b9 \u03b5\u03af\u03bd\u03b1\u03b9 \u03ba\u03b1\u03b8\u03bf\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03ae. \u039c\u03b5 \u03c4\u03bf\u03bd \u039d\u03b9\u03ba\u03cc\u03bb\u03b1 \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03ae\u03b8\u03b7\u03ba\u03b5 \u03bf \u03b1\u03c3\u03c6\u03b1\u03bb\u03ae\u03c2 \u03c7\u03ce\u03c1\u03bf\u03c2 \u03cc\u03c0\u03bf\u03c5 \u03ba\u03b1\u03c4\u03ac\u03c6\u03b5\u03c1\u03b1 \u03bd\u03b1 \u03b5\u03ba\u03c6\u03c1\u03b1\u03c3\u03c4\u03ce \u03b5\u03bb\u03b5\u03cd\u03b8\u03b5\u03c1\u03b1. \u0397 \u03c3\u03c5\u03bd\u03ad\u03c0\u03b5\u03b9\u03ac \u03c4\u03bf\u03c5, \u03b7 \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7, \u03bf\u03b9 \u03b8\u03b5\u03c1\u03b1\u03c0\u03b5\u03c5\u03c4\u03b9\u03ba\u03ad\u03c2 \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03ad\u03c2 \u03c0\u03bf\u03c5 \u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03ae\u03c3\u03b1\u03bc\u03b5 \u03c3\u03b5 \u03ba\u03ac\u03b8\u03b5 \u03c3\u03b7\u03bc\u03b5\u03af\u03bf \u03c4\u03b7\u03c2 \u03b4\u03b9\u03b1\u03b4\u03c1\u03bf\u03bc\u03ae\u03c2, \u03bc\u03bf\u03c5 \u03ad\u03b4\u03c9\u03c3\u03b1\u03bd \u03c4\u03b7 \u03b4\u03cd\u03bd\u03b1\u03bc\u03b7 \u03bd\u03b1 \u03c6\u03c9\u03c4\u03af\u03c3\u03c9 \u03c3\u03c9\u03c3\u03c4\u03ac \u03c4\u03b1 \u03b4\u03cd\u03c3\u03ba\u03bf\u03bb\u03b1 \u03c3\u03b7\u03bc\u03b5\u03af\u03b1 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03c3\u03c5\u03bd\u03b5\u03b9\u03b4\u03b7\u03c4\u03bf\u03c0\u03bf\u03af\u03b7\u03c3\u03b7 \u03bd\u03b1 \u03c3\u03c5\u03bd\u03b5\u03c7\u03af\u03c3\u03c9 \u03bd\u03b1 \u03b2\u03b5\u03bb\u03c4\u03b9\u03ce\u03bd\u03bf\u03bc\u03b1\u03b9 \u03bc\u03b5 \u03c5\u03c0\u03bf\u03bc\u03bf\u03bd\u03ae \u03ba\u03b1\u03b9 \u03c3\u03c4\u03b1\u03b8\u03b5\u03c1\u03cc\u03c4\u03b7\u03c4\u03b1. \u03a0\u03ac\u03bd\u03c4\u03b1 \u03b8\u03b1 \u03b5\u03af\u03bc\u03b1\u03b9 \u03b5\u03c5\u03b3\u03bd\u03ce\u03bc\u03c9\u03bd \u03b3\u03b9' \u03b1\u03c5\u03c4\u03ae \u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03c0\u03bb\u03b7\u03ba\u03c4\u03b9\u03ba\u03ae \u03b5\u03bd\u03c3\u03c5\u03bd\u03b1\u03af\u03c3\u03b8\u03b7\u03c3\u03ae \u03c4\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03c4\u03bf\u03bd \u03ac\u03c1\u03c4\u03b9\u03bf \u03b5\u03c0\u03b1\u03b3\u03b3\u03b5\u03bb\u03bc\u03b1\u03c4\u03b9\u03c3\u03bc\u03cc \u03c4\u03bf\u03c5",
